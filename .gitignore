*.py[cod]

# numba writes its on-disk kernel cache next to the sources
*.nbi
*.nbc

# Packaging artifacts
build/
# rig.mll's builds, one folder per Maya version (plugins/build.bat, plugins/build.sh)
/plugins/[0-9][0-9][0-9][0-9]/
dist/
*.egg-info/

# Maya writes a swatch cache next to every texture it previews
.mayaSwatches/
